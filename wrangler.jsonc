{
  "name": "hegemony",
  "main": "apps/server/cloudflare.mjs",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node scripts/build-cloudflare.mjs" },
  "assets": {
    "directory": "./dist/cloudflare",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOMS", "class_name": "GameRooms" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRooms"] }]
}
